+namespace phi {
+namespace dtype {
+struct float16; }}
+
+// declare is_floating_point specialization before including musa_fp16.h
+namespace std {
+template <>
+struct is_floating_point<phi::dtype::float16>
+    : std::integral_constant<
+          bool,
+          std::is_same<
+              phi::dtype::float16,
+              typename std::remove_cv<phi::dtype::float16>::type>::value> {};
+}
+
+#ifdef PADDLE_WITH_MUSA
+#include <musa.h>
+#endif  // PADDLE_WITH_MUSA

