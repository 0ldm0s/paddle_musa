+//        << phi::dynload::mudnnGetErrorString(stat) << ". "
+//        << GetExternalErrorMsg(stat);
+//   return sout.str();
+// }
+
+/*************** MUBLAS ERROR ***************/
+inline bool is_error(mublasStatus_t stat) {
+  return stat != MUBLAS_STATUS_SUCCESS;
+}
+
+inline std::string build_nvidia_error_msg(mublasStatus_t stat) {
+  std::ostringstream sout;
+  sout << "MUBLAS error(" << stat << "). ";
+  return sout.str();
+}
+
+/*************** MUSPARSE ERROR ***************/
+inline bool is_error(musparseStatus_t stat) {
+  return stat != MUSPARSE_STATUS_SUCCESS;
+}
+
+inline std::string build_nvidia_error_msg(musparseStatus_t stat) {
+  std::ostringstream sout;
+  sout << "MUSparse error(" << stat << "). " << GetExternalErrorMsg(stat);
+  return sout.str();
+}
+
+/*************** MUSOLVER ERROR ***************/
