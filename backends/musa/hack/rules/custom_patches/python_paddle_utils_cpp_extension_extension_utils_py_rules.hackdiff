+def prepare_unix_musaflags(cflags):
+    if not cflags:
+        return cflags
+    out = []
+    skip_next = False
+    for a in cflags:
+        if skip_next:
+            skip_next = False
+            continue
+        if a in ("--expt-relaxed-constexpr", "--expt-extended-lambda"):
+            continue
+        if a in ("-ccbin", "-gencode", "-Xcompiler"):
+            skip_next = True
+            continue
+        if a.startswith("-arch=sm") or a.startswith("-arch=compute"):
+            continue
+
+        out.append(a)
+
+    need_macros = ["-DPADDLE_WITH_MUSA", "-DEIGEN_USE_GPU", "-DNVCC"]
+    for m in need_macros:
+        if m not in out:
+            out.append(m)
+
+    return out
