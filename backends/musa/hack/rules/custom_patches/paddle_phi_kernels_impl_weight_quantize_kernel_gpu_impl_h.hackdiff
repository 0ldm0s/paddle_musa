+  if (n >= total_vec_n) return;
+
+  const int4* vec_weight_data_ptr = reinterpret_cast<const int4*>(weight_data);
+
+  phi::AlignedVector<float, VectorSize> abs_max;
+#pragma unroll
+  for (int i = 0; i < VectorSize; ++i) abs_max[i] = 0.0f;
+
+#pragma unroll
+  for (int k = 0; k < total_k; ++k) {
+    int64_t linear_index = k * total_vec_n + n;
+    phi::AlignedVector<T, VectorSize> w;
+    *reinterpret_cast<int4*>(&w) = vec_weight_data_ptr[linear_index];
+#pragma unroll
+    for (int i = 0; i < VectorSize; ++i) {
+      abs_max[i] = fmaxf(abs_max[i], static_cast<float>(fabsf(w[i])));
+    }
+  }
+
+  phi::AlignedVector<ScaleT, VectorSize> scale;
+#pragma unroll
+  for (int i = 0; i < VectorSize; ++i) {
+    scale[i] = static_cast<ScaleT>(abs_max[i] / 7.0f);
+  }
+  *reinterpret_cast<float4*>(scale_data + VectorSize * n) =
+      *reinterpret_cast<float4*>(&scale);
+
+  int base_n = static_cast<int>(n * VectorSize);
+  int base_n_pair = base_n >> 1;
+
+  for (int k = 0; k < total_k; ++k) {
+    int64_t linear_index = k * total_vec_n + n;
+    phi::AlignedVector<T, VectorSize> w;
+    *reinterpret_cast<int4*>(&w) = vec_weight_data_ptr[linear_index];
+
+    uint8_t q[VectorSize];
+
+#pragma unroll
+    for (int i = 0; i < VectorSize; ++i) {
+      float amax = abs_max[i];
+      int int_weight = 0;
+      if (amax > 0.0f) {
+        float weight_elt = (static_cast<float>(w[i]) / amax) * 7.0f;
+        float scaled = lroundf(weight_elt);
+        int_weight = static_cast<int>(scaled);
+        int_weight = max(-7, min(7, int_weight));
+      } else {
+        int_weight = 0;
+      }
+      q[i] = static_cast<uint8_t>(int_weight) & 0x0F;
+    }
+
+    uint8_t b0 = (uint8_t)((q[0] & 0x0F) | ((q[1] & 0x0F) << 4));
+    uint8_t b1 = (uint8_t)((q[2] & 0x0F) | ((q[3] & 0x0F) << 4));
+    uint8_t b2 = (uint8_t)((q[4] & 0x0F) | ((q[5] & 0x0F) << 4));
+    uint8_t b3 = (uint8_t)((q[6] & 0x0F) | ((q[7] & 0x0F) << 4));
+
+    quanted_weight_data[(base_n_pair + 0) * total_k + k] = (int8_t)b0;
+    quanted_weight_data[(base_n_pair + 1) * total_k + k] = (int8_t)b1;
+    quanted_weight_data[(base_n_pair + 2) * total_k + k] = (int8_t)b2;
+    quanted_weight_data[(base_n_pair + 3) * total_k + k] = (int8_t)b3;
+  }

