+template <typename T, int VecSize>
+__global__ void gather_with_mask_permute_rowwise_kernel(
+    const T* dy,                   // [permuted_tokens, d]
+    const int* scatter_index,      // [s, k]
+    const float* combine_weights,  // [s, k]
+    T* dx,                         // [s, d]
+    int64_t num_rows,              // s
+    int64_t k,                     // k
+    int64_t dim,                   // d
+    int64_t num_active,
+    int64_t capacity,
+    int64_t world_size,
+    int64_t num_local_experts,
+    int64_t blocks_per_row) {
+  extern __shared__ char shared_buf[];
+  int* scatter_index_shared = reinterpret_cast<int*>(shared_buf);
+  float* combine_weights_shared =
+      reinterpret_cast<float*>(scatter_index_shared + k);
+
+  int64_t block_id = static_cast<int64_t>(blockIdx.x);
+  int64_t row = block_id / blocks_per_row;
+  int64_t tile_id = block_id % blocks_per_row;
+
+  if (row >= num_rows) {
+    return;
+  }
+
+  for (int64_t i = threadIdx.x; i < k; i += blockDim.x) {
+    scatter_index_shared[i] = scatter_index[row * k + i];
+    combine_weights_shared[i] = combine_weights[row * k + i];
+  }
+  __syncthreads();
+
+  int64_t di_begin =
+      (tile_id * blockDim.x + threadIdx.x) * static_cast<int64_t>(VecSize);
+  if (di_begin >= dim) {
+    return;
+  }
+
+  phi::AlignedVector<T, VecSize> out_vec;
+  for (int i = 0; i < VecSize; ++i) {
+    out_vec[i] = static_cast<T>(0);
+  }
+
+  for (int64_t i = 0; i < k; ++i) {
+    int64_t id = static_cast<int64_t>(scatter_index_shared[i]);
+    if (num_active >= 0 && id >= num_active) {
+      continue;
+    }
+    if (id < 0) {
+      continue;
+    }
+    if (combine_weights_shared[i] <= 0.f) {
+      continue;
+    }
+
+    int64_t remaining_after_irank = id % (num_local_experts * capacity);
+    int64_t irank = id / (num_local_experts * capacity);
+    int64_t local_iexpert = remaining_after_irank / capacity;
+    int64_t row_in_expert = remaining_after_irank % capacity;
+
+    int64_t permuted_id =
+        local_iexpert * (world_size * capacity) + irank * capacity + row_in_expert;
+
+    int64_t in_offset = permuted_id * dim + di_begin;
+
+    if constexpr (VecSize == 4) {
+      phi::AlignedVector<T, VecSize> in_vec;
+      phi::Load<T, VecSize>(dy + in_offset, &in_vec);
+      for (int j = 0; j < VecSize; ++j) {
+        out_vec[j] += in_vec[j];
+      }
+    } else {
+      out_vec[0] += dy[in_offset];
+    }
+  }
+
+  int64_t out_offset = row * dim + di_begin;
+  if constexpr (VecSize == 4) {
+    phi::Store<T, VecSize>(out_vec, dx + out_offset);
+  } else {
+    dx[out_offset] = out_vec[0];
+  }
+}
+
+template <typename T, int64_t vec_size>
+__global__ void gather_with_mask_kernel(
+    const T* dy,                   // [s*k, d]

