+#if defined(PADDLE_WITH_CUDA) || defined(PADDLE_WITH_HIP)
+  m.def("is_float16_supported", [](const GPUPlace &place) -> bool {
+  // Only GPUs with Compute Capability >= 53 support float16
+#ifdef PADDLE_WITH_HIP
+    return true;
+#else
+    return platform::GetGPUComputeCapability(place.device) >= 53;
+#endif
+  });
+  m.def("is_bfloat16_supported", [](const GPUPlace &place) -> bool {
+  // Only GPUs with Compute Capability >= 80 support bfloat16
+#ifdef PADDLE_WITH_HIP
+    return true;
+#else
+    return platform::GetGPUComputeCapability(place.device) >= 80;
+#endif
+  });
+#elif defined(PADDLE_WITH_CUSTOM_DEVICE)
+  m.def("is_float16_supported", [](const GPUPlace &place) -> bool {
+    return phi::DeviceManager::IsFloat16Supported(
+        phi::CustomPlace("musa", place.device));
+  });
+  m.def("is_bfloat16_supported", [](const GPUPlace &place) -> bool {
+    return phi::DeviceManager::IsBFloat16Supported(
+        phi::CustomPlace("musa", place.device));
+  });
+#endif
